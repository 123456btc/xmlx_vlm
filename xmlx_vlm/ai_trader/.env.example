# AI Trader OMS 环境变量示例
# 复制到项目根目录：cp xmlx_vlm/ai_trader/.env.example .env
# 实盘交易前请仔细阅读 xmlx_vlm/ai_trader/README.md

# ======================== 模式配置 ========================
# 实盘开关：设置为 1 才允许真实下单（仍需 CLI 传入 --live）
AI_TRADER_LIVE=0

# 交易所：paper（纸盘）或 hyperliquid
AI_TRADER_EXCHANGE=paper

# 风控模板：conservative / moderate / aggressive / custom
AI_TRADER_RISK_PROFILE=conservative

# 干跑模式：设置为 1 时只过风控不提交交易所
AI_TRADER_DRY_RUN=0

# ======================== Hyperliquid 凭证 ========================
# 钱包地址（实盘必填）
HL_API_WALLET_ADDRESS=

# 方式一：本地私钥签名（开发/测试用，不推荐生产）
HL_API_PRIVATE_KEY=

# 方式二：外部签名器（生产推荐，私钥不落地）
HL_SIGNER_ENDPOINT=

# 是否使用 Hyperliquid 测试网
HL_TESTNET=0

# ======================== 风控阈值（自定义模板时生效） ========================
# AI_TRADER_MAX_DAILY_LOSS_PCT=1.0
# AI_TRADER_MAX_SINGLE_POSITION_PCT=10.0
# AI_TRADER_MAX_TOTAL_POSITION_PCT=20.0
# AI_TRADER_MAX_SINGLE_ORDER_NOTIONAL=1000
# AI_TRADER_MIN_ORDER_NOTIONAL=10
# AI_TRADER_MAX_PRICE_DEVIATION_PCT=0.5
# AI_TRADER_MAX_ORDERS_PER_MINUTE=6
# AI_TRADER_MAX_ORDERS_PER_SECOND=2
# AI_TRADER_MIN_AVAILABLE_MARGIN_PCT=40.0
